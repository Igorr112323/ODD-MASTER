{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Форма таблицы ведомости ТС ОДД на чертеже",
  "description": "Черновик формы (GOST-011). Колонки, ширины и высоты строк — данные, не код.",
  "type": "object",
  "required": ["normRef", "verification", "title", "titleRowHeightMm", "rowHeightMm", "cellPaddingRatio", "textFillRatio", "columns"],
  "additionalProperties": true,
  "properties": {
    "normRef": { "type": "object" },
    "verification": { "type": "string", "enum": ["Placeholder", "Unverified", "CuratorExtracted", "StudentVerified"] },
    "markers": { "type": "array", "items": { "type": "string", "pattern": "^GOST-[0-9]{3}$" } },
    "note": { "type": "string" },
    "title": { "type": "string" },
    "titleRowHeightMm": { "type": "number", "exclusiveMinimum": 0 },
    "rowHeightMm": { "type": "number", "exclusiveMinimum": 0 },
    "cellPaddingRatio": { "type": "number", "minimum": 0, "exclusiveMaximum": 0.5 },
    "textFillRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "widthMm"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "widthMm": { "type": "number", "exclusiveMinimum": 0 },
          "numeric": { "type": "boolean" }
        }
      }
    }
  }
}
