{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sign-catalog.schema.json",
  "title": "Каталог знаков",
  "type": "object",
  "required": [
    "catalog",
    "title",
    "normRef",
    "verification",
    "signs"
  ],
  "properties": {
    "catalog": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "normRef": {
      "type": "object",
      "required": [
        "doc",
        "clause"
      ],
      "properties": {
        "doc": {
          "type": "string",
          "minLength": 1
        },
        "clause": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "figure": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "string",
      "enum": [
        "Placeholder",
        "Unverified",
        "CuratorExtracted",
        "StudentVerified"
      ]
    },
    "colorStatus": {
      "type": "string",
      "enum": [
        "Placeholder",
        "Unverified",
        "CuratorExtracted",
        "StudentVerified"
      ]
    },
    "colorNote": {
      "type": "string"
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^GOST-[0-9]{3}$"
      }
    },
    "signTemplate": {
      "type": "object",
      "properties": {
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "demoPriority": {
          "type": "integer",
          "minimum": 0
        },
        "orientation": {
          "type": "string",
          "enum": [
            "asTable",
            "vertical"
          ]
        },
        "textPosition": {
          "type": "string",
          "enum": [
            "center",
            "top",
            "bottom"
          ]
        },
        "textWidthRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "signs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "name",
          "group",
          "shape",
          "sizeTableId",
          "isPlate",
          "colors",
          "normRef",
          "verification"
        ],
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+){1,3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "shape": {
            "type": "string",
            "enum": [
              "TriangleUp",
              "TriangleDown",
              "Circle",
              "Square",
              "Diamond",
              "Octagon",
              "RectangleVertical",
              "RectangleHorizontal"
            ]
          },
          "sizeTableId": {
            "type": "string"
          },
          "isPlate": {
            "type": "boolean"
          },
          "colors": {
            "type": "object"
          },
          "pictogram": {
            "type": [
              "object",
              "null"
            ]
          },
          "text": {
            "type": [
              "object",
              "null"
            ]
          },
          "parameterKind": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          },
          "normRef": {
            "type": "object",
            "required": [
              "doc",
              "clause"
            ],
            "properties": {
              "doc": {
                "type": "string",
                "minLength": 1
              },
              "clause": {
                "type": "string",
                "minLength": 1
              },
              "table": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "figure": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "verification": {
            "type": "string",
            "enum": [
              "Placeholder",
              "Unverified",
              "CuratorExtracted",
              "StudentVerified"
            ]
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Идентификаторы примитивов состава из config/elements/elements.json (CR-22)."
          },
          "demoPriority": {
            "type": "integer",
            "minimum": 0,
            "description": "Приоритет оцифровки и демо (Q-018): 1 — первым."
          },
          "orientation": {
            "type": "string",
            "enum": [
              "asTable",
              "vertical"
            ],
            "description": "Ориентация относительно таблицы прил. Д: vertical — поворот H↔B (CR-25)."
          },
          "textPosition": {
            "type": "string",
            "enum": [
              "center",
              "top",
              "bottom"
            ]
          },
          "textWidthRatio": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "description": "JSON Schema (draft-07). Синтаксис проверяется тестом ConfigSchemaTests; семантические проверки выполняет ConfigValidator в ядре (ADR-0014)."
}
