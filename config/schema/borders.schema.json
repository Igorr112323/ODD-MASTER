{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "borders.schema.json",
  "title": "Каймы и допуски",
  "type": "object",
  "required": [
    "normRef",
    "verification",
    "outerBorderWidthMm",
    "plateBorderWidthMm",
    "innerBorderWidthMm"
  ],
  "properties": {
    "normRef": {
      "type": "object",
      "required": [
        "doc",
        "clause"
      ],
      "properties": {
        "doc": {
          "type": "string",
          "minLength": 1
        },
        "clause": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "figure": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "string",
      "enum": [
        "Placeholder",
        "Unverified",
        "CuratorExtracted",
        "StudentVerified"
      ]
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^GOST-[0-9]{3}$"
      }
    },
    "outerBorderWidthMm": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signs",
          "value"
        ],
        "properties": {
          "signs": {
            "type": "string",
            "description": "Список номеров и диапазонов: '1.5 - 1.7, 2.4'. См. ADR-0005."
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "plateBorderWidthMm": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "redBorderInnerCornerRadiusMm": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "outerBorderMayBeOmitted": {
      "type": "object"
    },
    "innerBorderWidthMm": {
      "type": [
        "number",
        "null"
      ],
      "description": "null до сверки с рисунками прил. Д (GOST-001)"
    },
    "innerBorderWidthNote": {
      "type": "string"
    },
    "tolerances": {
      "type": "object"
    }
  },
  "description": "JSON Schema (draft-07). Синтаксис проверяется тестом ConfigSchemaTests; семантические проверки выполняет ConfigValidator в ядре (ADR-0014)."
}
