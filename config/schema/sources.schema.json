{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sources.schema.json",
  "title": "Реестр нормативных документов",
  "type": "object",
  "required": [
    "normRef",
    "verification",
    "sources"
  ],
  "properties": {
    "normRef": {
      "type": "object",
      "required": [
        "doc",
        "clause"
      ],
      "properties": {
        "doc": {
          "type": "string",
          "minLength": 1
        },
        "clause": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "figure": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "string",
      "enum": [
        "Placeholder",
        "Unverified",
        "CuratorExtracted",
        "StudentVerified"
      ]
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^GOST-[0-9]{3}$"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "doc",
          "title",
          "approvedBy",
          "usedFor",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "doc": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "approvedBy": {
            "type": "string"
          },
          "effectiveFrom": {
            "type": [
              "string",
              "null"
            ]
          },
          "replaces": {
            "type": [
              "string",
              "null"
            ]
          },
          "usedFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "string",
            "enum": [
              "Placeholder",
              "Unverified",
              "CuratorExtracted",
              "StudentVerified"
            ]
          }
        }
      }
    }
  },
  "description": "JSON Schema (draft-07). Синтаксис проверяется тестом ConfigSchemaTests; семантические проверки выполняет ConfigValidator в ядре (ADR-0014)."
}
