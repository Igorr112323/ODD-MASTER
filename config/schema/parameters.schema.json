{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "parameters.schema.json",
  "title": "Параметры на знаках (табл. Д.1)",
  "type": "object",
  "required": [
    "normRef",
    "verification",
    "rules"
  ],
  "properties": {
    "normRef": {
      "type": "object",
      "required": [
        "doc",
        "clause"
      ],
      "properties": {
        "doc": {
          "type": "string",
          "minLength": 1
        },
        "clause": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "figure": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verification": {
      "type": "string",
      "enum": [
        "Placeholder",
        "Unverified",
        "CuratorExtracted",
        "StudentVerified"
      ]
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^GOST-[0-9]{3}$"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signs",
          "parameter"
        ],
        "properties": {
          "signs": {
            "type": "string",
            "description": "Список номеров и диапазонов: '1.5 - 1.7, 2.4'. См. ADR-0005."
          },
          "parameter": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "unitShownOnSign": {
            "type": "boolean"
          },
          "multipleOf": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "oneOf": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "above20MultipleOf": {
            "type": "number"
          },
          "stepMinutes": {
            "type": "integer"
          },
          "oneOfMinutes": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "fromHours": {
            "type": "number"
          },
          "multipleOfHours": {
            "type": "number"
          },
          "kmRanges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "description": "JSON Schema (draft-07). Синтаксис проверяется тестом ConfigSchemaTests; семантические проверки выполняет ConfigValidator в ядре (ADR-0014)."
}
