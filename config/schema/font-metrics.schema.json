{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odd-master.local/schema/font-metrics.schema.json",
  "title": "Метрики шрифта для вписывания надписей (измеренные + условные допуски)",
  "type": "object",
  "required": [
    "fontId",
    "fontFamily",
    "capHeightRatio",
    "defaultAdvanceRatio",
    "maxHeightRatio",
    "paddingRatio",
    "lineGapRatio",
    "advanceRatios",
    "normRef",
    "verification",
    "markers",
    "minCapHeightMm"
  ],
  "properties": {
    "fontId": {
      "type": "string"
    },
    "fontFamily": {
      "type": "string"
    },
    "capHeightRatio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "defaultAdvanceRatio": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maxHeightRatio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "paddingRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.4
    },
    "lineGapRatio": {
      "type": "number",
      "minimum": 0
    },
    "advanceRatios": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "normRef": {
      "type": "object"
    },
    "verification": {
      "type": "string",
      "enum": [
        "Placeholder",
        "Unverified",
        "CuratorExtracted",
        "StudentVerified"
      ]
    },
    "note": {
      "type": "string"
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^GOST-[0-9]{3}$"
      }
    },
    "measuredFrom": {
      "type": "object",
      "description": "Откуда сняты метрики: файл шрифта и его контрольная сумма. Пусто — метрики условные.",
      "required": [
        "file",
        "sha256",
        "tool"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "unitsPerEm": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "glyphs": {
          "type": "integer",
          "minimum": 0
        },
        "tool": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "minCapHeightMm": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Минимальная высота прописных, мм: ниже неё текст переносится, а не уменьшается. Условное значение, GOST-002."
    }
  }
}
