{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odd-master.local/schema/pictogram.schema.json",
  "title": "Пиктограмма знака в клетках масштабной сетки прил. Б",
  "type": "object",
  "required": ["id", "sign", "status", "source", "grid", "layers"],
  "properties": {
    "id": { "type": "string" },
    "sign": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){1,3}$" },
    "status": { "type": "string", "enum": ["Placeholder", "StudentTranscribed", "StudentVerified", "Unverified"] },
    "source": { "type": "string" },
    "note": { "type": "string" },
    "grid": {
      "type": "object",
      "required": ["cellsAcross", "spans", "origin", "yAxis"],
      "properties": {
        "cellsAcross": { "type": "integer", "minimum": 1 },
        "spans": { "type": "string", "enum": ["A", "B", "D", "H"] },
        "origin": { "type": "string", "enum": ["center"] },
        "yAxis": { "type": "string", "enum": ["up"] }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "color", "shapes"],
        "properties": {
          "role": { "type": "string", "enum": ["symbol", "border", "text"] },
          "color": { "type": "string" },
          "shapes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string", "enum": ["polygon", "polyline", "circle", "text"] },
                "points": { "type": "array", "items": { "type": "array", "items": { "type": "number" } } },
                "width": { "type": "number", "minimum": 0 },
                "c": { "type": "array", "items": { "type": "number" } },
                "r": { "type": "number", "minimum": 0 },
                "fill": { "type": "boolean" },
                "value": { "type": "string" },
                "heightCells": { "type": "number" },
                "anchor": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
